# ─────────────────────────────────────────────────────────────
#  Скопируйте этот файл в .env и заполните своими значениями.
#  .env в git не коммитится. Токен видите только вы.
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ID Instagram-аккаунта (Business или Creator, связанный с Facebook-страницей).
# Где взять: Graph API Explorer → GET /me/accounts → у нужной страницы
# запросить ?fields=instagram_business_account
# Можно оставить пустым — скрипт определит его сам по токену.
IG_USER_ID=

# Долгоживущий access token (60 дней, потом обновлять).
# Приложение Meta должно иметь права:
#   instagram_business_content_publish, instagram_business_basic, pages_show_list
IG_ACCESS_TOKEN=

# Публичный HTTPS-адрес папки, куда вы зальёте output/reels/*.mp4
# Instagram скачивает видео сам по ссылке — байты через API не передаются.
# Подойдёт Cloudflare R2, S3, Bunny, любой статический хостинг.
# Пример: https://media.themhs.ru/reels
MEDIA_BASE_URL=

# Время публикаций, 3 раза в день, локальное время машины
POST_TIMES=12:00,15:00,18:00

# Версия Graph API
GRAPH_VERSION=v23.0

# Дублировать рилс в основную ленту профиля
SHARE_TO_FEED=true

# Кадр для обложки в миллисекундах от начала ролика.
# На нуле кадр чёрный из-за фейда — обложка в профиле выглядит пустой.
THUMB_OFFSET=1000

# ─── YouTube ───────────────────────────────────────────────
# Из Google Cloud Console → APIs & Services → Credentials.
# Тип клиента — Desktop app, иначе локальная выдача доступа не сработает.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Заполняется автоматически командой npm run youtube:auth
YOUTUBE_REFRESH_TOKEN=

# Непроверенный проект Google всё равно кладёт ролики в private.
# После прохождения аудита можно ставить public.
YOUTUBE_PRIVACY=private

# ─── Комментарии → директ ──────────────────────────────────
# Отдельный токен для комментариев и сообщений. Права на них выдаются
# отдельно от прав на публикацию, и перевыпуск ради директа не должен
# трогать токен, которым выкладываются рилсы. Пусто — берётся общий
# IG_ACCESS_TOKEN.
IG_DM_TOKEN=

# Слово-триггер в комментарии.
DM_KEYWORD=skill

# Ссылка на телеграм-бота. Метка ?start=ig_comment подставляется сама.
TG_BOT_URL=https://t.me/

# Тексты лежат в файлах рядом с кодом, править их удобнее там:
#   dm-message.txt — само письмо в директ
#   dm-reply.txt   — ответ под комментарием «ответили в директ»
#   dm-closed.txt  — ответ, если директ у человека закрыт
# Переменные DM_TEXT, DM_REPLY_TEXT и DM_CLOSED_TEXT перебивают файлы —
# нужны, если текст хочется держать в секретах, а не в репозитории.

# Через Facebook Login приватные ответы уходят от имени связанной
# Страницы, а не Instagram-аккаунта. Скрипт находит её сам по токену —
# заполняйте, только если Страниц несколько и нужна конкретная.
PAGE_ID=
