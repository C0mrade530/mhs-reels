{
  "name": "mhs-prompt-cards",
  "version": "1.0.0",
  "private": true,
  "description": "Локальный генератор визуальных карточек 1080x1920 для Instagram/Reels из JSON со 100 промптами",
  "type": "module",
  "scripts": {
    "render": "node src/render.js",
    "validate": "node src/render.js --validate-only",
    "reels": "node src/reels.js",
    "hooks": "node src/hooks.js",
    "publish": "node src/publish.js",
    "radar": "node src/radar.js",
    "radar:images": "node src/radar-images.js",
    "radar:cards": "node src/render-radar.js",
    "radar:reels": "node src/reels.js --series=radar",
    "radar:publish": "node src/publish.js --series=radar",
    "carousel": "node src/render-carousel.js",
    "carousel:themes": "node src/render-carousel.js --themes",
    "youtube": "node src/youtube.js",
    "youtube:auth": "node src/youtube-auth.js"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  }
}
